# ─────────────────────────────────────────────────────────────────────────────
# SourceLens — API / server configuration
# Copy to `.env` in the repository root. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# Optional: long random token for scripted API access via
# `Authorization: Bearer <token>` or `x-admin-token`.
ADMIN_TOKEN=
# REQUIRED in production: long random string used to salt the daily visitor
# hash. Keep it stable across deploys or repeat-visitor counts will reset.
SOURCELENS_SALT=

# ── Supabase (required for production) ───────────────────────────────────────
# Dashboard → Project Settings → API. Run supabase/schema.sql first.
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — SERVER ONLY. Never expose it in browser code.
SUPABASE_SERVICE_KEY=
# anon/publishable key — used to verify user tokens through the auth proxy.
SUPABASE_ANON_KEY=
# Private bucket created by schema.sql; CSV exports are written here.
SUPABASE_STORAGE_BUCKET=exports

# ── Behaviour ────────────────────────────────────────────────────────────────
# Reject tracker events for domains that were never added in the dashboard.
ALLOW_AUTO_SITE=false
# true bypasses Supabase Auth and runs as a local user. NEVER use in public.
AUTH_DISABLED=false
# Comma-separated origins allowed to POST events, or * for any.
CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────────
# LEAVE THESE IN web/.env.local INSTEAD (frontend):
#   API_ORIGIN=http://127.0.0.1:3001
#   NEXT_PUBLIC_SITE_URL=https://your-public-domain.com
# ─────────────────────────────────────────────────────────────────────────────
